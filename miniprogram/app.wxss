page {
  background: #fff5f7;
  color: #3d3340;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  line-height: 1.2;
  background: transparent;
}

button::after {
  border: 0;
}

input {
  box-sizing: border-box;
}
